%init
close all;
clear all;
clc;

%config
FILE_NAME = "SN_m_tot_V2.0.txt";
DELTA_T = 1;
LINE_WIDTH = 0.1;
FIGURE_WIDTH = 3000;
FIGURE_HEIGHT = 2000;

%points = [1, 5, 9, 13];
%points = [1, 37, 71, 75, 79];
points = 1:10:801;

%read data
data = readtable(FILE_NAME);
sizeofData = size(data);
sizeofData = sizeofData(1);

%handle data
sunspotNum = data.Var4;
period = datetime(data.Var1, data.Var2, 1);
T = zeros(1, length(points));
T_idx = 1;

%compare og, ma and fft
figure;
t = tiledlayout(length(points), 2);
t.TileSpacing = "compact";
t.Padding = "loose";

for point = points
    %ma
    nexttile;
    grid on;
    
    margin = floor(point / 2);
    filter = [];
    for i = 1:point
        filter(end + 1) = 1 / i;
    end
    x = period((margin + 1) : (end - margin));
    y = conv(sunspotNum(:), filter, "valid");

    plot(x(:), y(:), LineWidth = LINE_WIDTH);
    xlabel("Time(Month)");
    ylabel("Sunspots");
    title(point + "-MA Sumspots Number");
    
    %fft
    nexttile;
    grid on;

    N = length(y);
    x = ((-N / 2) : (N / 2 - 1)) / (DELTA_T * N);
    y = abs(fftshift(fft(y - mean(y))));

    [val, idx] = max(y(:));
    T(T_idx) = abs((1 / (x(idx))) / 12);

    plot(x(:), y(:), LineWidth = LINE_WIDTH);
    xlim([0, abs(5 * x(idx))]);
    xlabel("Frequency");
    ylabel("Magnitude");
    title("Spectrum of " + point + "-MA Sumspots Number (T=" + T(T_idx) + "years)");
    T_idx = T_idx + 1;
end

%save
saveas(gcf, "Figure1.png");

%compare system response
figure;
t = tiledlayout(length(points), 1);
t.TileSpacing = "compact";
t.Padding = "loose";

for point = points
    nexttile;
    grid on;
    
    filter = [];
    for i = 1:point
        filter(end + 1) = 1 / i;
    end
    
    N = sizeofData;
    x = ((-N / 2) : (N / 2 - 1)) / (DELTA_T * N);
    y = abs(fftshift(fft(filter, length(x))));

    plot(x(:), y(:), LineWidth = LINE_WIDTH);
    xlabel("Frequency");
    ylabel("Magnitude");
    title(point + "-Point Filter System Response");
end

%save
saveas(gcf, "Figure2.png");

%compare diff T of diff ma
figure;
plot(points, T);

%save
saveas(gcf, "Figure2.png");
